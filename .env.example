# API klic z resend.com (Settings -> API Keys) - NENI to heslo k emailu,
# jde jen o token urceny vyhradne k odesilani emailu pres tuto sluzbu
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Odesilajici adresa - dokud nemas na Resend overenou vlastni domenu,
# musi zustat presne takto (jinak Resend odeslani odmitne)
FROM_EMAIL=Notifikator bytu <onboarding@resend.dev>

# Kam se ma notifikace poslat - v rezimu bez overene domeny musi byt
# totozna s adresou, kterou ses na Resend registroval
TO_EMAIL=jan.verner@gmail.com

# Cesta k souboru se stavem - na Railway nastavit na cestu uvnitr pripojeneho Volume
STATE_FILE=/data/state.json

# Sledovana stranka (obvykle neni treba menit)
TARGET_URL=https://rezidencehury.cz/cenik/
